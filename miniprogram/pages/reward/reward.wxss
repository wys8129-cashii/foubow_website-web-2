.page { padding: 48rpx 40rpx; min-height: 100vh; background: #f8fafc; }
.header { text-align: center; margin-bottom: 48rpx; }
.title { display: block; font-size: 44rpx; font-weight: 700; color: #06b6d4; }
.subtitle { display: block; font-size: 26rpx; color: #6b7280; margin-top: 12rpx; }

.tiers { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 40rpx; }
.tier {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx; background: #fff; border-radius: 20rpx;
  border: 2rpx solid #e5e7eb;
}
.tier-active { border-color: #06b6d4; background: #ecfeff; }
.tier-amount { font-size: 36rpx; font-weight: 700; color: #111827; }
.tier-name { font-size: 26rpx; color: #6b7280; }

.pay-btn {
  width: 100%; padding: 32rpx; border-radius: 20rpx; border: none;
  background: linear-gradient(135deg, #06b6d4, #22d3ee); color: #fff;
  font-size: 32rpx; font-weight: 600;
}

.success { text-align: center; margin-top: 40rpx; }
.success-icon {
  width: 120rpx; height: 120rpx; border-radius: 50%; margin: 0 auto 24rpx;
  background: #06b6d4; color: #fff; font-size: 64rpx; line-height: 120rpx;
}
.success-title { display: block; font-size: 36rpx; font-weight: 700; color: #111827; margin-bottom: 32rpx; }
.order-box {
  display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx;
  background: #fff; border-radius: 16rpx; margin-bottom: 24rpx;
}
.order-label { font-size: 24rpx; color: #9ca3af; }
.order-no { font-size: 28rpx; color: #111827; font-family: monospace; word-break: break-all; }
.admin-tip { font-size: 28rpx; color: #6b7280; margin-bottom: 12rpx; }
.admin-wechat { color: #06b6d4; font-weight: 700; margin: 0 8rpx; }
.admin-desc { display: block; font-size: 24rpx; color: #9ca3af; line-height: 1.6; }
