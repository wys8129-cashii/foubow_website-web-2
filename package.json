{
  "name": "foubow-website",
  "version": "1.0.0",
  "description": "Foubow Knowledge Lab Website",
  "scripts": {
    "build:css": "tailwindcss -i src/styles/index.css -o public/css/tailwind.css",
    "watch:css": "tailwindcss -i src/styles/index.css -o public/css/tailwind.css --watch",
    "build": "npm run build:css",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.6",
    "multer": "^2.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
