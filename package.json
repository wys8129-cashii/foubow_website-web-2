{
  "name": "foubow-frontend",
  "version": "1.0.0",
  "description": "Foubow 前端静态站点（部署于火山云 IGA Pages），后端独立部署于 veFaaS",
  "scripts": {
    "build:css": "tailwindcss -i src/styles/index.css -o public/css/tailwind.css",
    "watch:css": "tailwindcss -i src/styles/index.css -o public/css/tailwind.css --watch",
    "build": "npm run build:css"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
