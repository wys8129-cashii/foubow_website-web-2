# ======================
# Foubow 后端环境变量
# ======================
# 本地开发：复制为 .env 并填入真实值
# veFaaS 部署：不要上传 .env，改在「函数配置 → 环境变量」里逐项配置

# ── 必需：Supabase（登录鉴权）──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role 密钥：仅后端使用，用于读写 user_api_keys（绕过 RLS）。
# 从 Supabase 控制台 Settings → API 获取，务必保密，不要提交到仓库或下发给前端。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── 必需：Coze（素材数据工作流）──
# COZE_TOKEN 是你在 Coze 的个人访问令牌（pat_xxx），仅存于服务端，绝不可下发给前端或插件
COZE_TOKEN=pat_xxxxxxxxxxxx
COZE_APP_ID=7635532712145076243

# ── 重要：CORS 白名单 ──
# 前后端分离部署时，必须填前端域名，否则浏览器会拦截跨域请求。
# 支持逗号分隔多个域名；留空或填 * 表示允许所有来源（仅建议本地调试用）
CORS_ORIGIN=https://your-frontend.igapages.com

# ── 可选：端口 ──
# veFaaS 会自动注入 _FAAS_RUNTIME_PORT，无需手动配置
# 本地/ECS 默认 2300
# PORT=2300

# ── 可选：Coze API 地址（一般不用改）──
# COZE_BASE_URL=https://api.coze.cn/v1/workflow/run
# COZE_STREAM_BASE_URL=https://api.coze.cn/v1/workflow/stream_run

# ── 可选：特殊工作流覆盖（代码里已有默认值）──
# COZE_UPDATE_MATERIAL_COVER_WORKFLOW_ID=7673732265646964774
# COZE_UPDATE_MATERIAL_COVER_APP_ID=7635532712145076243
# COZE_REORDER_COLLECTION_WORKFLOW_ID=7674446127790145563
# COZE_REORDER_COLLECTION_APP_ID=7635532712145076243

# ── 可选：微信小程序 + 虚拟支付（打赏功能）──
# 走「虚拟支付：个人」通道（打赏/虚拟礼物），无需企业商户号。
# 以下变量用于 /api/pay/* 下单签名，仅后端使用，绝不下发前端。
WX_MINI_APPID=wxXXXXXXXXXXXXXXXX
WX_MINI_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WX_VP_OFFER_ID=xxxxxxxx
WX_VP_APPKEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WX_VP_ENV=prod            # sandbox（沙箱）/ prod（现网）
# WX_VP_MCH_ID=            # 如改走普通商户号则填
# 打赏档位（金额:名称 逗号分隔；前端不可篡改金额，后端校验）
# REWARD_TIERS=6.6:小额鼓励,16.6:暖心支持,66:深度共建
